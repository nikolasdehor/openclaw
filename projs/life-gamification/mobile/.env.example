# Life Gamification Mobile - Variáveis de Ambiente
# Copie este arquivo para .env e ajuste conforme necessário

# Backend API URL
BACKEND_URL=http://76.13.164.69:8000

# App Config
EXPO_PUBLIC_APP_NAME=Life Gamification
EXPO_PUBLIC_APP_VERSION=1.1.0-rc.1

# Notificações Push (FCM/APNs) - Opcional
# FCM_SERVER_KEY=sua_chave_fcm_aqui
# APNS_KEY_ID=seu_key_id
# APNS_TEAM_ID=seu_team_id

# Analytics (ex: Mixpanel, Amplitude) - Opcional
# ANALYTICS_TOKEN=seu_token_aqui

# URL da loja (para compartilhamento)
STORE_URL_IOS=https://apps.apple.com/app/life-gamification
STORE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.lifegamification

# Feature flags (0 ou 1)
FEATURE_ANALYTICS=1
FEATURE_SOCIAL=1
FEATURE_HEALTH_INTEGRATION=1
FEATURE_WIDGET=1

# Modo debug (0 ou 1)
DEBUG=0
